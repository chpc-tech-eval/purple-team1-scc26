---
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 3NCRYP+3D</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="bar">
      <span class="brand">3NCRYP+3D</span>
      <span class="sub">SCC26 Student Project Platform</span>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>
