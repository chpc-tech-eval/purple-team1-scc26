---
import Workspace from "../layouts/Workspace.astro";
const REPO = "https://github.com/chpc-tech-eval/purple-team1-scc26";
---
<Workspace title="Team overview" active="overview" crumb="Overview">
  <p id="changed" class="notice ok" hidden>Password updated. Your other sessions were signed out.</p>

  <div class="page-title">
    <div>
      <h1>Your team, at a glance.</h1>
      <p class="pt-sub"><span id="teamName">Purple Team 1</span> &nbsp;/&nbsp; Agentic security observability, detection &amp; forensics</p>
    </div>
  </div>

  <section class="hero-banner">
    <div class="signal-bars" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="hb-body">
      <p class="eyebrow c">Week 04 / Agent Control Plane</p>
      <h2>From telemetry to understanding.</h2>
      <p>Run a fixed, read-only diagnostic. Keep the evidence. Review an explanation grounded in what was actually observed.</p>
    </div>
    <div class="hb-action">
      <a class="btn" href="/crypty/">Open Crypty →</a>
      <span class="sub">Read-only · No infrastructure changes</span>
    </div>
  </section>

  <section class="metrics" aria-label="Platform metrics">
    <div class="metric">
      <div class="m-label">Team members</div>
      <div class="m-value" id="mUsers">—</div>
      <div class="m-note">Accounts in the platform database</div>
    </div>
    <div class="metric">
      <div class="m-label">Sign-ins recorded</div>
      <div class="m-value" id="mLogins">—</div>
      <div class="m-note">Persisted in PostgreSQL</div>
    </div>
    <div class="metric">
      <div class="m-label">Application uptime</div>
      <div class="m-value" id="mUptime">—</div>
      <div class="m-note">Since the last backend start</div>
    </div>
    <div class="metric">
      <div class="m-label">Database version</div>
      <div class="m-value" id="mDb">—</div>
      <div class="m-note">PostgreSQL · persistent storage</div>
    </div>
  </section>

  <div class="panels split">
    <section class="panel">
      <div class="panel-head">
        <h3>Recent diagnostics</h3>
        <a class="btn link" href="/crypty/">View history →</a>
      </div>
      <div id="recent"><p class="empty">Loading…</p></div>
    </section>

    <section class="panel">
      <h3>Built for a bounded workflow</h3>
      <div class="principles pad-t">
        <div class="principle">
          <div class="p-h"><b>01</b>Evidence before explanation</div>
          <p>An explanation is an interpretation, not proof.</p>
        </div>
        <div class="principle">
          <div class="p-h"><b>02</b>Your authorised range only</div>
          <p>No shell, provisioning or unrestricted agent.</p>
        </div>
        <div class="principle">
          <div class="p-h"><b>03</b>Keep the chain reproducible</div>
          <p>Record run IDs, image digests and Git SHAs.</p>
        </div>
      </div>
    </section>
  </div>

  <div class="row-foot">
    <span>Engineering lives in GitHub. Live collaboration lives in Discord.</span>
    <a href={REPO} target="_blank" rel="noopener noreferrer">Open team repository ↗</a>
  </div>
</Workspace>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  if (new URLSearchParams(location.search).has("changed")) $("changed").hidden = false;

  const fmt = (iso: string) => {
    try {
      return new Intl.DateTimeFormat("en-GB", {
        day: "2-digit", month: "short", year: "numeric",
        hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "UTC",
      }).format(new Date(iso)).replace(",", "") + " UTC";
    } catch { return iso; }
  };

  async function loadStatus() {
    try {
      const s = await (await fetch("/api/status", { credentials: "same-origin" })).json();
      $("mUsers").textContent = String(s.database.users).padStart(2, "0");
      $("mLogins").textContent = String(s.database.logins);
      $("mUptime").textContent = `${Math.round(s.uptime_seconds / 60)} min`;
      $("mDb").textContent = String(s.database.server_version).split(" ")[0];
    } catch { /* metrics stay as — */ }
  }

  async function loadRecent() {
    const box = $("recent");
    try {
      const r = await fetch("/api/crypty/tasks", { credentials: "same-origin" });
      if (!r.ok) {
        box.replaceChildren(Object.assign(document.createElement("p"), {
          className: "empty",
          textContent: "Diagnostics are limited to the team's allowlist. Open Crypty for details.",
        }));
        return;
      }
      const items = ((await r.json()).items || []).slice(0, 3);
      box.replaceChildren();
      if (!items.length) {
        box.append(Object.assign(document.createElement("p"), { className: "empty", textContent: "No diagnostics yet." }));
        return;
      }
      for (const t of items) {
        const row = document.createElement("a");
        row.className = "diag-row";
        row.href = `/crypty/task/?id=${encodeURIComponent(t.task_id)}`;

        const left = document.createElement("div");
        const name = document.createElement("div");
        name.className = "dr-name";
        name.textContent = t.status === "failed" && t.failure_code
          ? String(t.failure_code).replace(/[_-]+/g, " ") : "Platform health diagnostic";
        const meta = document.createElement("div");
        meta.className = "dr-meta";
        meta.textContent = `${String(t.task_id).slice(0, 8)}  ·  ${fmt(t.created_at)}`;
        left.append(name, meta);

        const status = document.createElement("div");
        status.className = `dr-status s-${t.status}`;
        status.textContent = `● ${t.status.charAt(0).toUpperCase()}${t.status.slice(1)}`;

        const go = document.createElement("div");
        go.className = "dr-go";
        go.setAttribute("aria-hidden", "true");
        go.textContent = "↗";

        row.append(left, status, go);
        box.append(row);
      }
    } catch {
      box.replaceChildren(Object.assign(document.createElement("p"), { className: "empty", textContent: "Could not load diagnostics." }));
    }
  }

  loadStatus();
  loadRecent();
</script>
