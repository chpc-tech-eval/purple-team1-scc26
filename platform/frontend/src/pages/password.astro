---
import Base from "../layouts/Base.astro";
---
<Base title="Change password">
  <section class="card narrow">
    <h2><span class="dot warn" aria-hidden="true"></span>Set your password</h2>
    <p id="first" class="notice" hidden>You're signed in with a password that was shared with you. Choose your own to continue.</p>
    <form id="pw">
      <label>Current password <input name="current_password" type="password" autocomplete="current-password" required maxlength="256" /></label>
      <label>New password <input name="new_password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" /></label>
      <label>Repeat new password <input name="repeat" type="password" autocomplete="new-password" required minlength="12" maxlength="128" /></label>
      <p class="hint">At least 12 characters, not containing your username. A short phrase you'll remember works well, e.g. <code>purple tea at 5pm</code>.</p>
      <button type="submit">Save password →</button>
      <p id="msg" class="error" role="alert" hidden></p>
    </form>
    <p class="actions"><a id="back" href="/home/" hidden>← Back to team home</a></p>
  </section>
</Base>

<script>
  const form = document.getElementById("pw") as HTMLFormElement;
  const msg = document.getElementById("msg") as HTMLParagraphElement;
  fetch("/api/me", { credentials: "same-origin" }).then(async (r) => {
    if (!r.ok) return location.replace("/");
    const me = await r.json();
    if (me.must_change_password) (document.getElementById("first") as HTMLElement).hidden = false;
    else (document.getElementById("back") as HTMLElement).hidden = false;
  });
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.hidden = true;
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (data.new_password !== data.repeat) {
      msg.textContent = "The new passwords don't match";
      msg.hidden = false;
      return;
    }
    const r = await fetch("/api/password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ current_password: data.current_password, new_password: data.new_password }),
    });
    if (r.ok) {
      location.replace("/home/?changed=1");
    } else {
      msg.textContent = (await r.json().catch(() => ({}))).error || "Could not change the password";
      msg.hidden = false;
    }
  });
</script>
