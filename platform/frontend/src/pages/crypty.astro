---
import Workspace from "../layouts/Workspace.astro";
---
<Workspace title="Crypty diagnostics" active="crypty" crumb="Crypty diagnostics">
  <div class="page-title">
    <div>
      <h1>Meet Crypty.</h1>
      <p class="pt-sub">A bounded diagnostic. An evidence-backed explanation. A durable record.</p>
    </div>
  </div>

  <section class="hero-banner">
    <div class="signal-bars" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="orb" aria-hidden="true"></div>
    <div class="hb-body">
      <p class="eyebrow c">Platform health · Read-only</p>
      <h2>Understand the latest Prometheus evidence.</h2>
      <p>Crypty collects the fixed diagnostic evidence, saves it, then asks the approved model to explain only those observations. It cannot run commands or change your environment.</p>
    </div>
    <div class="hb-action">
      <button id="run" type="button" disabled>Run diagnostic →</button>
      <span class="sub">Available to authorised team members</span>
    </div>
  </section>

  <p id="state" class="notice" role="status" hidden></p>

  <section class="panel">
    <div class="panel-head">
      <h3>Diagnostic history</h3>
      <span class="ph-note" id="runCount">All timestamps in UTC</span>
    </div>
    <p class="panel-sub">Canonical history is stored in the ACP ledger, independent of the Hermes worker.</p>
    <div class="table">
      <div class="thead" aria-hidden="true">
        <span>Task / Created</span><span>Diagnostic</span><span>Status</span><span>Recorded model</span><span></span>
      </div>
      <div id="rows"><p class="empty">Loading…</p></div>
    </div>
  </section>

  <section class="fail-callout" id="failCallout" hidden>
    <span class="fc-bang" aria-hidden="true">!</span>
    <div>
      <div class="fc-title" id="failTitle"></div>
      <div class="fc-body">Evidence was retained. No explanation was generated. A failed run is never reported as healthy.</div>
    </div>
  </section>

  <div class="flow" aria-label="Request boundary">
    <span class="f-node">Browser</span><span class="f-arr">→</span>
    <span class="f-node on">Student Platform</span><span class="f-arr">→</span>
    <span class="f-node">ACP Ledger</span><span class="f-arr">→</span>
    <span class="f-node">Hermes</span><span class="f-arr">→</span>
    <span class="f-node">Approved Model</span>
  </div>
</Workspace>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const ACTIVE = new Set(["queued", "running"]);
  let timer: number | undefined;

  const fmt = (iso: string) => {
    try {
      return new Intl.DateTimeFormat("en-GB", {
        day: "2-digit", month: "short", year: "numeric",
        hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false, timeZone: "UTC",
      }).format(new Date(iso)).replace(",", "");
    } catch { return iso; }
  };
  const cap = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);

  function show(msg: string, ok = false) {
    const el = $("state");
    el.textContent = msg;
    el.className = ok ? "notice ok" : "notice";
    el.hidden = !msg;
  }
  async function api(path: string, init: RequestInit = {}) {
    const r = await fetch(path, { credentials: "same-origin", ...init });
    const body = await r.json().catch(() => ({}));
    return { r, body };
  }

  function renderRows(items: any[]) {
    const box = $("rows");
    box.replaceChildren();
    $("runCount").textContent = `${items.length} run${items.length === 1 ? "" : "s"} · All timestamps in UTC`;
    if (!items.length) {
      box.append(Object.assign(document.createElement("p"), { className: "empty", textContent: "No diagnostics yet. Run one to populate the ledger." }));
      return;
    }
    for (const t of items) {
      const row = document.createElement("a");
      row.className = "trow";
      row.href = `/crypty/task/?id=${encodeURIComponent(t.task_id)}`;

      const id = document.createElement("div");
      id.className = "tc-id";
      id.textContent = String(t.task_id).slice(0, 8);
      const when = document.createElement("small");
      when.textContent = fmt(t.created_at);
      id.append(when);

      const diag = document.createElement("div");
      diag.className = "tc-diag";
      diag.textContent = "Platform health diagnostic";

      const status = document.createElement("div");
      status.className = `tc-status s-${t.status}`;
      status.textContent = `● ${cap(t.status)}`;

      const model = document.createElement("div");
      model.className = "tc-model";
      model.textContent = t.model || (t.status === "failed" ? "Not returned" : "—");

      const go = document.createElement("div");
      go.className = "tc-go";
      go.setAttribute("aria-hidden", "true");
      go.textContent = "→";

      row.append(id, diag, status, model, go);
      box.append(row);
    }

    const failed = items.find((t) => t.status === "failed");
    const callout = $("failCallout");
    if (failed) {
      const reason = failed.failure_code ? String(failed.failure_code).replace(/[_-]+/g, " ") : "diagnostic failed";
      $("failTitle").textContent = `Run ${String(failed.task_id).slice(0, 8)} · ${reason}`;
      callout.hidden = false;
    } else {
      callout.hidden = true;
    }
  }

  async function refresh() {
    const { r, body } = await api("/api/crypty/tasks");
    if (!r.ok) return show(body.error || "could not load history");
    const items = body.items || [];
    renderRows(items);
    window.clearTimeout(timer);
    if (items.some((t: any) => ACTIVE.has(t.status))) timer = window.setTimeout(refresh, 3000);
  }

  async function load() {
    const { r, body } = await api("/api/crypty");
    if (!r.ok) return show(body.error || "Crypty is unavailable");
    if (!body.configured) { show("Crypty is not configured on this platform yet."); $("rows").replaceChildren(); return; }
    if (!body.allowed) { show("Diagnostics are limited to the team's allowlist, and your account isn't on it."); }
    else ($("run") as HTMLButtonElement).disabled = false;
    await refresh();
  }

  $("run").addEventListener("click", async () => {
    const btn = $("run") as HTMLButtonElement;
    btn.disabled = true;
    show("Submitting…");
    const { r, body } = await api("/api/crypty/diagnostics", {
      method: "POST",
      headers: { "Content-Type": "application/json", "Idempotency-Key": crypto.randomUUID() },
      body: "{}",
    });
    btn.disabled = false;
    if (!r.ok) return show(body.error || "the diagnostic was not accepted");
    show(`Accepted: task ${String(body.task_id).slice(0, 8)} is ${body.status}. Evidence first, then the explanation.`, true);
    await refresh();
  });

  load();
</script>
