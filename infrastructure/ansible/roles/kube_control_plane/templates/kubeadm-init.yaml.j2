apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_host }}"
  bindPort: {{ kube_control_plane_api_port }}
nodeRegistration:
  name: "{{ inventory_hostname }}"
  criSocket: unix:///run/containerd/containerd.sock
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: "{{ kube_control_plane_cluster_name }}"
kubernetesVersion: "v{{ kube_control_plane_kubernetes_version }}"
controlPlaneEndpoint: "{{ kube_control_plane_api_endpoint }}"
networking:
  podSubnet: "{{ kube_control_plane_pod_cidr }}"
  serviceSubnet: "{{ kube_control_plane_service_cidr }}"
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
